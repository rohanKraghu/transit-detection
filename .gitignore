# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated data.  figures/ and results/metrics.json ARE committed, so the
# README renders and the reported numbers can be checked without a re-run;
# the feature matrix is a build artefact and is not.
results/dataset.npz
results/real_injection/dataset.npz
results/tls/dataset.npz
results/systematics/dataset.npz
# The fitted classifier is a pickle tied to the scikit-learn version that
# wrote it; run_pipeline.py rebuilds it in two minutes.
results/model.joblib
results/real_injection/model.joblib
results/tls/model.joblib
results/systematics/model.joblib
# Single-star reports from python -m transitml.vet.
results/vet/
# Downloaded MAST light curves (~60 MB); data/real_injection/ lists the
# targets, so the cache can be rebuilt with one run.
results/real_injection/base_curves.npz

# OS noise
.DS_Store
# Downloaded TOI-host curves for the real-label benchmark; rebuilt from the
# TOI table in data/toi_benchmark/ by one run.
results/**/toi_curves.npz
results/**/toi_curves.tried.json
# Their target pixel files for the centroid test (about 1 MB a star).
results/**/toi_tpfs/
# The sector 1 to 13 replication of the TOI benchmark commits only its report;
# its model and metrics are the default run's.
results/toi_sectors_01_13/*
!results/toi_sectors_01_13/toi_benchmark.json
!results/toi_sectors_01_13/toi_benchmark.txt
# Models trained on TOI dispositions: their feature matrices and fitted
# classifiers are rebuilt by one run each.
results/toi_trained/**/dataset.npz
results/toi_trained/**/model.joblib
# Batch mode: the per-star result cache and downloaded sector curves are
# rebuilt by one run; candidates.csv, summary.json and dashboard.html of the
# demo sector are committed.
results/batch/**/cache/
results/batch/**/curves/
# Kepler DR25: per-star light curves (about 0.5 MB each) and the folded views.
# data/kepler_dr25/dr25_tce_labels.csv lists every TCE, so one run rebuilds both.
results/kepler_dr25/curves/
results/kepler_dr25/training_set.npz
# The larger DR25 sample and the fitted CNN weights are rebuilt by one run each.
results/kepler_dr25/large/training_set.npz
results/kepler_dr25/cnn/cnn_models.pt
# Known-planet fits (python -m transitml.real_check planets): comparison.csv,
# comparison.txt and each planet's vet JSON are committed, the figures are not.
results/real_planets/reports/**/*.png
# The full 34,032-TCE set and its CNN weights.
results/kepler_dr25/full/training_set.npz
results/kepler_dr25/full_cnn/cnn_models.pt
