# Generated data.  figures/ and results/metrics.json ARE committed, so the
# README renders and the reported numbers can be checked without a re-run;
# the feature matrix is a build artefact and is not.
results/dataset.npz
results/real_injection/dataset.npz
results/systematics/dataset.npz
# The fitted classifier is a pickle tied to the scikit-learn version that
# wrote it; run_pipeline.py rebuilds it in two minutes.
results/model.joblib
results/real_injection/model.joblib
results/systematics/model.joblib
# Single-star reports from python -m transitml.vet.
results/vet/
# Downloaded MAST light curves (~60 MB); data/real_injection/ lists the
# targets, so the cache can be rebuilt with one run.
results/real_injection/base_curves.npz

# OS noise
.DS_Store
